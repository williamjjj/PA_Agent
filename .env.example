# Required on Vercel: use a managed PostgreSQL connection URL, ideally pooled.
DATABASE_URL=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable and back it up. Changing it makes saved account credentials unreadable.
PA_WEB_ENCRYPTION_KEY=
# Imported once into the database; subsequently managed by the administrator.
PA_WEB_INVITE_CODE=
# Or explicitly allow public registration:
PA_WEB_REGISTRATION=0
# Optional one-time creation of an independent administrator. No default password.
PA_WEB_ADMIN_USERNAME=
PA_WEB_ADMIN_PASSWORD=
# Local data only; SQLite is never used on Vercel.
PA_WEB_DATA_DIR=.pa-agent-web
